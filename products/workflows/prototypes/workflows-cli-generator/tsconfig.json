{
    "compilerOptions": {
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "target": "ESNext",
        "module": "Preserve",
        "moduleResolution": "bundler",
        "lib": ["ESNext"],
        "types": ["node"],
        "noEmit": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true
    },
    "include": ["cli", "sdk", "example", "dev"]
}
