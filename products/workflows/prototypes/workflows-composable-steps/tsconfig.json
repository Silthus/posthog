{
    "compilerOptions": {
        "target": "ES2022",
        "module": "Preserve",
        "moduleResolution": "bundler",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": ["bun"]
    },
    "include": ["sdk", "example", "dev"],
    "exclude": ["dev/breakages"]
}
